# Builder image for the maw guest kernel and initramfs.
#
# The base image is pinned by digest, and apt installs from a fixed snapshot of the Debian
# archive (snapshot.debian.org), so every build uses the same compiler and tools.
# Guest/build.sh tags the image with a hash of this file, so any change here produces a new
# image. Guest/README.md describes how to update the pins.

# debian:trixie-20261005-slim, multi-architecture image index.
FROM docker.io/library/debian:trixie-20261005-slim@sha256:a29215f6a35e51e22adffa17f89e9d2ef06214e64a2bad10d765c46aea49f11f

# Point the image's apt sources at the snapshot. Release files in the snapshot are past their
# Valid-Until date by design, so that check is disabled; signatures are still verified.
RUN set -eu; \
    snapshot=20261019T000000Z; \
    sources=/etc/apt/sources.list.d/debian.sources; \
    sed -i \
        -e "s|http://deb.debian.org/debian-security|http://snapshot.debian.org/archive/debian-security/$snapshot|" \
        -e "s|http://deb.debian.org/debian\$|http://snapshot.debian.org/archive/debian/$snapshot|" \
        -e '/^Signed-By:/a Check-Valid-Until: no' \
        "$sources"; \
    if grep -q deb.debian.org "$sources"; then \
        echo "Containerfile: $sources still refers to deb.debian.org" >&2; exit 1; \
    fi; \
    apt-get -o Acquire::Retries=5 update; \
    apt-get -o Acquire::Retries=5 install --yes --no-install-recommends \
        bc \
        binutils \
        bison \
        bzip2 \
        flex \
        gcc \
        gzip \
        libc6-dev \
        libelf-dev \
        libssl-dev \
        make \
        musl-tools \
        perl \
        python3 \
        rsync \
        xz-utils; \
    rm -rf /var/lib/apt/lists/*

ENV LC_ALL=C.UTF-8 \
    TZ=UTC
