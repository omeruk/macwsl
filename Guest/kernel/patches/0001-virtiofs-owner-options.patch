 #ifdef CONFIG_FUSE_DAX
 	if (fc->dax_mode == FUSE_DAX_ALWAYS)
 		seq_puts(m, ",dax=always");
@@ -1888,6 +1894,10 @@
 	fc->allow_other = ctx->allow_other;
