@@ -700,6 +710,12 @@
 	/* show legacy mount options */
 	unsigned int legacy_opts_show:1;
 
+	/* Every inode shows owner_uid as its owner (virtiofs uid=) */
+	unsigned int owner_uid_set:1;
+
+	/* Every inode shows owner_gid as its group (virtiofs gid=) */
+	unsigned int owner_gid_set:1;
+
 	/*
 	 * fs kills suid/sgid/cap on write/chown/trunc. suid is killed on
 	 * write/trunc only if caller did not have CAP_FSETID.  sgid is killed
@@ -994,6 +1010,22 @@
 static inline struct fuse_conn *get_fuse_conn(struct inode *inode)
 {
 	return get_fuse_mount_super(inode->i_sb)->fc;
+}
+
+/* The owner of an inode with these attributes: the mount's, if it sets one */
+static inline kuid_t fuse_attr_uid(struct fuse_conn *fc,
+				   const struct fuse_attr *attr)
+{
+	return fc->owner_uid_set ? fc->owner_uid :
+				   make_kuid(fc->user_ns, attr->uid);
+}
+
+/* The group of an inode with these attributes: the mount's, if it sets one */
+static inline kgid_t fuse_attr_gid(struct fuse_conn *fc,
+				   const struct fuse_attr *attr)
+{
+	return fc->owner_gid_set ? fc->owner_gid :
+				   make_kgid(fc->user_ns, attr->gid);
 }
 
 static inline struct fuse_inode *get_fuse_inode(struct inode *inode)
