# MacWSL guest kernel configuration fragment.
#
# Guest/kernel/build-kernel.sh applies this file on top of `make allnoconfig` with
# scripts/kconfig/merge_config.sh, then runs `make olddefconfig`. Every option below must
# survive that step unchanged; Guest/scripts/verify-fragment.sh fails the build otherwise.
#
# The kernel is monolithic: everything is built in, and loadable modules are disabled.
# See docs/decisions/0003-guest-kernel.md for the reasons.

#
# General
#
CONFIG_LOCALVERSION="-macwsl"
# CONFIG_LOCALVERSION_AUTO is not set
# CONFIG_MODULES is not set
CONFIG_MULTIUSER=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_PRINTK=y
CONFIG_FUTEX=y
CONFIG_SHMEM=y
CONFIG_AIO=y
CONFIG_IO_URING=y
CONFIG_FILE_LOCKING=y
CONFIG_KEYS=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_SWAP=y
CONFIG_TTY=y
CONFIG_UNIX98_PTYS=y

#
# Platform: the arm64 virtual machines of Virtualization.framework and QEMU `virt`.
# allnoconfig keeps some of these enabled by default; they are listed so that the build
# verifies them.
#
CONFIG_ARM64_4K_PAGES=y
CONFIG_SMP=y
CONFIG_NR_CPUS=64
CONFIG_ARM_ARCH_TIMER=y
# Virtualization.framework provides a GICv3. GICv2 support is kept for QEMU fallback.
CONFIG_ARM_GIC=y
CONFIG_ARM_GIC_V3=y
# PSCI SYSTEM_OFF is how `poweroff` reaches the host.
CONFIG_ARM_PSCI_FW=y
# Virtio devices sit behind a generic ECAM PCI host bridge.
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_PCI_HOST_GENERIC=y
# PL011 UART: fallback early console (`earlycon`) when hvc0 is not available yet.
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_SERIAL_EARLYCON=y

#
# Virtio devices
#
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_BLK_DEV=y
CONFIG_VIRTIO_BLK=y
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_VIRTIO_NET=y
# Console on hvc0.
CONFIG_VIRTIO_CONSOLE=y
CONFIG_HVC_DRIVER=y
CONFIG_VIRTIO_BALLOON=y
# Entropy.
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y
# virtio-fs, used for /mnt/mac.
CONFIG_FUSE_FS=y
CONFIG_VIRTIO_FS=y
# vsock, used by the guest agent.
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y

#
# Filesystems
#
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_OVERLAY_FS=y
CONFIG_AUTOFS_FS=y
CONFIG_HUGETLBFS=y

#
# Executables
#
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
# Rosetta for Linux registers itself through binfmt_misc (phase 10).
CONFIG_BINFMT_MISC=y

#
# Initramfs
#
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y

#
# Networking
#
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_UNIX=y
CONFIG_PACKET=y
CONFIG_NET_SCHED=y
CONFIG_NET_SCH_FQ_CODEL=y

#
# Containers: Docker and Podman inside the distribution.
#
# Namespaces.
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_TIME_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
# cgroup v2 with every controller: cpu, cpuset, io, memory, hugetlb, pids, rdma, misc,
# perf_event, and dmem. The cgroup v1-only controllers that moby checks are enabled too.
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
# systemd recommends against real-time group scheduling.
# CONFIG_RT_GROUP_SCHED is not set
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_RDMA=y
CONFIG_CGROUP_DMEM=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_HUGETLB=y
CONFIG_CPUSETS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_PERF_EVENTS=y
CONFIG_CGROUP_PERF=y
CONFIG_CGROUP_BPF=y
CONFIG_CGROUP_MISC=y
# seccomp and BPF.
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
# Bridge, veth, and tun/tap.
CONFIG_BRIDGE=y
CONFIG_VLAN_8021Q=y
CONFIG_BRIDGE_VLAN_FILTERING=y
CONFIG_VETH=y
CONFIG_TUN=y
# Netfilter core, connection tracking, and NAT.
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
# nftables.
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_CT=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_REDIR=y
CONFIG_NFT_REJECT=y
# iptables-nft: x_tables matches and targets running on nf_tables.
CONFIG_NETFILTER_XTABLES=y
CONFIG_NFT_COMPAT=y
CONFIG_NETFILTER_XT_MARK=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_IPVS=y
CONFIG_IP_VS=y
# Legacy iptables tables. moby's check-config.sh lists the IPv4 and IPv6 filter, mangle,
# raw, and NAT tables as required, and since Linux 6.x they depend on the legacy x_tables
# options.
CONFIG_NETFILTER_XTABLES_LEGACY=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_IPTABLES_LEGACY=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_MANGLE=y
CONFIG_IP_NF_RAW=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_IPTABLES_LEGACY=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_MANGLE=y
CONFIG_IP6_NF_RAW=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y
CONFIG_IP6_NF_TARGET_REJECT=y

#
# systemd requirements (README "REQUIREMENTS", systemd v262.1). Options that also serve
# another group are listed there: DEVTMPFS, CGROUPS, UNIX, SYSFS, PROC_FS, AUTOFS_FS,
# TMPFS_XATTR, TMPFS_POSIX_ACL, NET_NS, USER_NS, IPV6, SECCOMP, SECCOMP_FILTER, NET_SCHED,
# NET_SCH_FQ_CODEL, CGROUP_SCHED, FAIR_GROUP_SCHED, CFS_BANDWIDTH, CGROUP_BPF, BPF_SYSCALL,
# BPF_JIT, and MEMCG.
#
CONFIG_FHANDLE=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EPOLL=y
CONFIG_EVENTFD=y
CONFIG_INOTIFY_USER=y
# BLK_DEV_BSG depends on the SCSI core. The guest has no SCSI devices; SCSI is enabled only
# because systemd lists BLK_DEV_BSG.
CONFIG_SCSI=y
CONFIG_BLK_DEV_BSG=y
CONFIG_EFI_PARTITION=y
CONFIG_PSI=y
# CONFIG_SYSFS_DEPRECATED is not set
# CONFIG_UEVENT_HELPER is not set
# CONFIG_FW_LOADER_USER_HELPER is not set
# DMIID is not applicable: on arm64, DMI depends on EFI, and VZLinuxBootLoader boots the
# kernel directly without firmware, so the guest has no SMBIOS tables to expose.
