#!/bin/sh
# /init for the maw initramfs.
#
# 1. Mounts proc, sysfs, devtmpfs, devpts, and a tmpfs on /run.
# 2. Prints one banner line: maw-initramfs <version> kernel=<uname -r>.
# 3. With maw.test=lsblk on the kernel command line, lists /dev/vd* (the virtio block
#    devices). The phase 03 integration tests use this.
# 4. With maw.test=poweroff, prints "maw-initramfs: poweroff" and powers off. Phase 03
#    and CI use this.
# 5. With maw.test=agent, runs the guest agent's self-test, which prints
#    "maw-agent self-test: ok" on success, and powers off. The QEMU smoke test uses this.
# 6. With maw.root=<device>, boots the distribution on that disk: checks and mounts it,
#    provides the guest agent to it as a runtime systemd unit, and switches to its systemd.
#    docs/decisions/0013-systemd-and-the-agent.md describes this path.
# 7. Otherwise, writes /etc/inittab and executes busybox init, which becomes PID 1 and
#    supervises the guest agent. With maw.debug=shell, init also runs a shell on /dev/hvc0.
#    This is the initramfs machine, which provisions distributions and serves
#    `mawd debug-boot`.
#
# With maw.clock=<seconds since 1970>, the clock is set first: the virtual machine has no
# real-time clock, and its clock otherwise starts at 1970.
#
# docs/decisions/0005-init-supervises-the-agent.md explains why init, not the agent, is PID 1
# on the initramfs machine.

export PATH=/sbin:/bin:/usr/sbin:/usr/bin

mountpoint -q /proc || mount -t proc -o nosuid,nodev,noexec proc /proc
mountpoint -q /sys || mount -t sysfs -o nosuid,nodev,noexec sysfs /sys
mountpoint -q /dev || mount -t devtmpfs -o nosuid,mode=0755 devtmpfs /dev
mkdir -p /dev/pts
mountpoint -q /dev/pts || mount -t devpts -o nosuid,noexec,mode=0620,ptmxmode=0666 devpts /dev/pts
mountpoint -q /run || mount -t tmpfs -o nosuid,nodev,mode=0755 tmpfs /run

echo "maw-initramfs $(cat /etc/maw-initramfs-version) kernel=$(uname -r)"

cmdline=" $(cat /proc/cmdline) "

# The value of a maw.<name>=<value> argument, or nothing.
argument() {
    for word in $cmdline; do
        case $word in
        "$1="*) echo "${word#*=}" ;;
        esac
    done
}

clock=$(argument maw.clock)
if [ -n "$clock" ]; then
    date -u -s "@$clock" > /dev/null || echo "maw-initramfs: could not set the clock to $clock" >&2
fi

# Prints a reason on the console and powers off: without its root file system, the machine
# has nothing to run.
fail_boot() {
    echo "maw-initramfs: $*" >&2
    echo "maw-initramfs: powering off" >&2
    poweroff -f
}

# Boots the distribution on $1. Does not return.
boot_distribution() {
    root_device=$1
    # e2fsck -p: 0 means clean, 1 that errors were corrected; anything else needs a person.
    e2fsck -p "$root_device"
    status=$?
    if [ "$status" -gt 1 ]; then
        fail_boot "the file system on $root_device has errors that e2fsck -p cannot repair (exit status $status)"
    fi
    mkdir -p /sysroot
    mount -t ext4 -o rw "$root_device" /sysroot || fail_boot "cannot mount $root_device"
    [ -x /sysroot/sbin/init ] || fail_boot "the distribution on $root_device has no /sbin/init"

    # systemd keeps a /run that is already mounted and reads runtime units from
    # /run/systemd/system, so the agent runs without being installed in the distribution.
    mount -t tmpfs -o nosuid,nodev,mode=0755 tmpfs /sysroot/run || fail_boot "cannot mount /run"
    mkdir -p /sysroot/run/maw /sysroot/run/systemd/system/sysinit.target.wants
    cp /sbin/maw-agent /sysroot/run/maw/maw-agent
    cat > /sysroot/run/systemd/system/maw-agent.service << 'UNIT'
[Unit]
Description=maw guest agent
Documentation=https://github.com/omeruk/macwsl/blob/main/docs/distributions.md
# Starts as soon as systemd does, and stays until the final kill at power-off, so that the
# host can open sessions while other units start and can request the shutdown.
DefaultDependencies=no

[Service]
ExecStart=/run/maw/maw-agent
Restart=always
RestartSec=100ms
# A restarted agent must not take its sessions with it.
KillMode=process
OOMScoreAdjust=-900
UNIT
    ln -s ../maw-agent.service /sysroot/run/systemd/system/sysinit.target.wants/maw-agent.service

    for directory in dev proc sys; do
        mount --move "/$directory" "/sysroot/$directory" || fail_boot "cannot move /$directory"
    done
    exec switch_root /sysroot /sbin/init
}

case $cmdline in
*" maw.test=lsblk "*)
    ls /dev/vd*
    ;;
esac

case $cmdline in
*" maw.test=poweroff "*)
    echo "maw-initramfs: poweroff"
    poweroff -f
    ;;
*" maw.test=agent "*)
    if [ -x /sbin/maw-agent ]; then
        /sbin/maw-agent self-test
    else
        echo "maw-agent self-test: FAILED: /sbin/maw-agent is not in this initramfs"
    fi
    poweroff -f
    ;;
esac

root_device=$(argument maw.root)
if [ -n "$root_device" ]; then
    if [ ! -x /sbin/maw-agent ]; then
        fail_boot "this initramfs has no guest agent, so it cannot boot a distribution"
    fi
    boot_distribution "$root_device"
fi

# busybox init reads /etc/inittab. Each line is <tty>::<action>:<command>; an empty <tty>
# means the console.
#
# - The agent is respawned whenever it exits, so that an agent crash does not panic the
#   kernel; init also reaps orphaned processes.
# - SIGUSR2 (from the agent's shutdown request, or `poweroff`) runs the shutdown actions.
#   maw-shutdown ends in `poweroff -f`, so init's own sequence, which sleeps for two
#   seconds, never runs.
debug_shell=false
case $cmdline in
*" maw.debug=shell "*) debug_shell=true ;;
esac
{
    if [ -x /sbin/maw-agent ]; then
        echo "::respawn:/sbin/maw-agent"
    else
        # A guest built without --agent: keep the console useful instead.
        echo "maw-initramfs: /sbin/maw-agent is missing; starting a shell on hvc0" >&2
        debug_shell=true
    fi
    if [ "$debug_shell" = true ]; then
        echo "hvc0::respawn:/bin/cttyhack /bin/sh -l"
    fi
    echo "::shutdown:/sbin/maw-shutdown"
} > /etc/inittab

exec /sbin/init
