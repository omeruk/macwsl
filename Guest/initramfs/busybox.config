# busybox configuration overrides, applied on top of `make defconfig` and verified with
# Guest/scripts/verify-fragment.sh in the same way as the kernel fragment.

# A static binary: the initramfs contains no shared libraries.
CONFIG_STATIC=y

# The tc applet does not build against kernel headers from Linux 6.8 or later, which removed
# the CBQ scheduler definitions it uses. It is not needed in the initramfs.
# CONFIG_TC is not set

# The initramfs ships the full e2fsprogs tools instead of busybox's reduced versions.
# CONFIG_MKE2FS is not set
# CONFIG_MKFS_EXT2 is not set
# CONFIG_TUNE2FS is not set

# Used by /init to give the interactive shell a controlling terminal on hvc0.
CONFIG_CTTYHACK=y
CONFIG_SETSID=y
CONFIG_MOUNTPOINT=y
CONFIG_POWEROFF=y
