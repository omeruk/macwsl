# busybox configuration overrides, applied on top of `make defconfig` and verified with
# Guest/scripts/verify-fragment.sh in the same way as the kernel fragment.

# A static binary: the initramfs contains no shared libraries.
CONFIG_STATIC=y

# The tc applet does not build against kernel headers from Linux 6.8 or later, which removed
# the CBQ scheduler definitions it uses. It is not needed in the initramfs.
# CONFIG_TC is not set

# SHA hardware acceleration exists only for x86 (SHA-NI). With it enabled, busybox 1.37.0
# does not compile for arm64: libbb/hash_md5_sha.c refers to the x86-only
# sha1_process_block64_shaNI.
# CONFIG_SHA1_HWACCEL is not set
# CONFIG_SHA256_HWACCEL is not set

# The initramfs ships the full e2fsprogs tools instead of busybox's reduced versions.
# CONFIG_MKE2FS is not set
# CONFIG_MKFS_EXT2 is not set
# CONFIG_TUNE2FS is not set

# Used by /init to give the interactive shell a controlling terminal on hvc0.
CONFIG_CTTYHACK=y
CONFIG_SETSID=y
CONFIG_MOUNTPOINT=y
CONFIG_POWEROFF=y

# PID 1 (docs/decisions/0005-init-supervises-the-agent.md): init reads /etc/inittab,
# respawns the guest agent, reaps orphans, and runs maw-shutdown on power-off.
CONFIG_INIT=y
CONFIG_FEATURE_USE_INITTAB=y

# Used by maw-shutdown.
CONFIG_KILL=y
CONFIG_USLEEP=y
CONFIG_READLINK=y
CONFIG_SYNC=y
CONFIG_UMOUNT=y
CONFIG_FEATURE_UMOUNT_ALL=y

# Used by the agent's self-test (tty) and the --shell integration tests (stty size).
CONFIG_TTY=y
CONFIG_STTY=y
